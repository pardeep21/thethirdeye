{"bin": {"thethirdeye-spike": "./dist/cli.js"},"dependencies": {"@thethirdeye/server": "^0.1.0","sharp": "^0.34.0"},"description": "Benchmark CLI: Meta Model API accuracy/latency for a blind shopkeeper's assistant (rupee notes, scenes, voice clips).","devDependencies": {"@types/node": "^22.0.0","typescript": "^5.6.0"},"engines": {"node": ">=18"},"name": "@thethirdeye/eval","scripts": {"build": "tsc","prebuild": "npm run build -w @thethirdeye/server","pretest": "npm run build -w @thethirdeye/server","pretypecheck": "npm run build -w @thethirdeye/server","test": "npm run build && node --test \"dist/**/*.test.js\"","spike": "npm run build && node dist/cli.js","start": "node dist/cli.js","typecheck": "tsc --noEmit"},"type": "module","version": "0.1.0"}