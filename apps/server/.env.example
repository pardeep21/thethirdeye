# Copy to .env (never commit the real one).
PROVIDER=mock
PORT=8080
# SQLite file for enrolled face embeddings (embeddings only, no photos).
THETHIRDEYE_DB=./thethirdeye.db

# M1 real providers (OpenAI-compatible). Leave unset for mock.
# Meta Model API:
# META_API_KEY=LLM|...|...
# META_BASE_URL=https://api.meta.ai/v1
# META_MODEL=muse-spark-1.3
# Triage token budget (default 400) and reasoning depth for muse-spark-1.3
# (minimal|low|medium|high|xhigh|max; "off" omits it; default minimal).
# TRIAGE_MAX_TOKENS=400
# META_REASONING_EFFORT=minimal
# OpenRouter-served Muse:
# OPENROUTER_API_KEY=...
# OPENROUTER_MODEL=meta/muse-spark-1.3
# Plain OpenAI / local Ollama (PROVIDER=openai|local):
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# 02 conversational agent (JSON-action mode; native tools only if
# scripts/probe-tools.mjs passes on Spark).
# AGENT_MODEL=muse-spark-1.3
# AGENT_MAX_TOKENS=600
# AGENT_IMAGE_PX=640
# AGENT_TOOL_MODE=json
# AGENT_REASONING_EFFORT=minimal
# Agent debug logs (prompts + raw responses, never image bytes).
# Default is ../eval/debug; empty string disables.
# AGENT_DEBUG_DIR=
# How long an utterance waits for its capture_now frame (ms).
# CAPTURE_TIMEOUT_MS=800

# 08 ship: shared WS token (phone sends it in hello; connections without
# it are closed with 4401). Unset = open server (local dev only).
# APP_TOKEN=change-me-on-the-server
# Debug files never carry image bytes unless this is 1 (local diagnosis).
# DEBUG_LOG_IMAGES=false
# Face sidecar: sidecar|stub (default: sidecar if :8765 answers, else stub).
# The cloud deploy runs FACES=stub; face recognition needs the sidecar.
# FACES=sidecar
# Run face detection every Nth frame (slow machines: 2).
# FACES_EVERY_N=1
# Centre-60% crop for the cash prompt on ultra-wide frames (0 disables).
# UW_CASH_CROP=1
