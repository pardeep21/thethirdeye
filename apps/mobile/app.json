{
  "expo": {
    "name": "TheThirdEye",
    "slug": "thethirdeye",
    "version": "0.1.0",
    "orientation": "portrait",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.thethirdeye.app"
    },
    "android": {
      "package": "com.thethirdeye.app"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a"
            ]
          }
        }
      ],
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "TheThirdEye needs camera access to see notes and people."
        }
      ],
      "expo-audio",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "TheThirdEye needs microphone access to hear your voice commands.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox"]
        }
      ]
    ]
  }
}
