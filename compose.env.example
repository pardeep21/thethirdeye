# Copy to .env (same directory as docker-compose.yml) and fill in.
# NEVER commit the real .env (gitignored).

# Public hostname pointing at the VPS (DNS A record). Caddy provisions TLS.
DOMAIN=eye.example.com

# Server provider: meta for live vision (needs META_API_KEY), mock for a
# dry run without any model spend.
PROVIDER=meta

# Meta Model API key (OpenAI-compatible). server/.env style: LLM|...|...
META_API_KEY=

# Shared WS token: the APK bakes the same value (EXPO_PUBLIC_APP_TOKEN).
# Generate something long: openssl rand -hex 24
APP_TOKEN=

# Optional overrides (defaults shown).
# META_BASE_URL=https://api.meta.ai/v1
# META_MODEL=muse-spark-1.3
# FACE_DETECTOR=yunet
